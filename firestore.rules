rules_version = '2';

// Nadie accede a Firestore desde un navegador.
//
// La app escribe con el SDK de administración desde el servidor, y ese SDK no
// pasa por estas reglas: por eso pueden negar todo sin romper nada. Cualquier
// acceso que estas reglas sí evaluarían vendría de un cliente, y no hay ningún
// cliente legítimo.
//
// Desplegar con:  pnpm reglas
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
