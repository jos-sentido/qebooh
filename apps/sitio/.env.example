# URL pública del sitio, sin barra final. Se usa en metadatos, sitemap y
# enlaces canónicos.
NEXT_PUBLIC_SITIO_URL=https://qeb-sitio.vercel.app

# Indexación en buscadores. Dejar vacío mientras se revisa desde tool.qeb.mx;
# poner "true" sólo cuando el sitio viva en qeb.mx.
NEXT_PUBLIC_INDEXAR=

# Formulario de contacto / demo. Los mensajes se envían por correo con Resend
# (https://resend.com). Sin estas variables el formulario responde con un
# error amable y sugiere escribir directo a contacto@qeb.mx.
RESEND_API_KEY=
# Remitente verificado en Resend (el dominio qeb.mx debe estar verificado).
CONTACTO_REMITENTE="QEB <sitio@qeb.mx>"
# Uno o varios destinatarios separados por coma.
CONTACTO_DESTINO=contacto@qeb.mx
