# Copiar a .env.local para desarrollo. En Vercel, cargar como variables de
# entorno del proyecto. Nunca commitear el archivo con valores reales.

# --- Claves de acceso a los índices -----------------------------------------
# Una por sección. Protegen el índice, que lista todo lo publicado; los enlaces
# individuales siguen abriéndose sin clave para poder compartirlos.
#
# Sin clave, la sección queda cerrada para todo el mundo (falla cerrado). Al
# cambiar una clave se cierran las sesiones abiertas de esa sección, que es lo
# que se espera al rotar una contraseña compartida.
QEB_CLAVE_PROPUESTAS=
QEB_CLAVE_REPORTES=
QEB_CLAVE_TOOL=

# --- Base de datos ----------------------------------------------------------
# Guarda el estado administrable: archivado, eliminado y bitácora. El contenido
# de las publicaciones vive en el repo y no necesita base de datos.
#
# Sin esta variable la app funciona, pero ese estado se pierde en cada
# despliegue: el índice avisa cuando está en ese modo.
#
# En serverless hay que apuntar al pooler del proveedor, no al puerto directo.
POSTGRES_URL=
